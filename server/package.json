{
  "name": "reztor-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "serve": "tsx src/main.ts",
    "protocol:emit": "tsx src/protocol/emit.ts",
    "bots": "tsx src/sim/bot.ts",
    "seed:faucet": "tsx scripts/seed-faucet.ts",
    "soak": "vitest run --config vitest.soak.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-golden": "UPDATE_GOLDEN=1 vitest run test/golden"
  },
  "dependencies": {
    "@anchor-lang/core": "1.1.2",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.10.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@anchor-lang/borsh": "1.1.2",
      "@anchor-lang/errors": "1.1.2"
    }
  }
}
